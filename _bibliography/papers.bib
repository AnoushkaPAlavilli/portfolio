@inproceedings{nguyen2024tinympc,
  title     = {TinyMPC: Model-Predictive Control on Resource-Constrained Microcontrollers},
  author    = {Nguyen, Khai and Schoedel, Sam and Alavilli, Anoushka and Plancher, Brian and Manchester, Zachary},
  booktitle = {2024 IEEE International Conference on Robotics and Automation (ICRA)},
  year      = {2024},
  abstract  = {Model-predictive control (MPC) is a powerful tool for controlling highly dynamic robotic systems subject to complex constraints. However, MPC is computationally demanding, and is often impractical to implement on small, resource-constrained robotic platforms. We present TinyMPC, a high-speed MPC solver with a low memory footprint targeting the microcontrollers common on small robots.},
  arxiv     = {2310.16985},
  code      = {https://github.com/TinyMPC/TinyMPC},
  website   = {https://tinympc.org/},
  selected  = {true},
  abbr      = {ICRA},
}
